<?xml version="1.0" encoding="UTF-8"?>
<csv-inputs xmlns="http://axelor.com/xml/ns/data-import"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/data-import https://axelor.com/xml/ns/data-import/data-import_8.2.xsd">

  <!-- Séquence de numérotation des OR (MetaSequence, consommée via
       JpaSequence.nextValue("jbl.repair.order.seq") dans JblRepairOrderManagementRepository)
       => OR-00001, OR-00002... -->
  <input file="jbl_meta_sequence.csv" separator=";" type="com.axelor.meta.db.MetaSequence"
    search="self.name = :name">
    <bind column="name" to="name"/>
    <bind column="prefix" to="prefix"/>
    <bind column="padding" to="padding"/>
    <bind column="increment" to="increment"/>
    <bind column="initial" to="initial"/>
    <bind column="next" to="next"/>
  </input>

  <!-- Permissions Shiro de base sur les entités JBL (deny-all par défaut, admins = accès total) -->
  <input file="jbl_permissions.csv" separator=";" type="com.axelor.auth.db.Permission"
    search="self.name = :name">
    <bind column="name" to="name"/>
    <bind column="object" to="object"/>
    <bind column="canRead" to="canRead" eval="canRead == '1' ? 'true' : 'false'"/>
    <bind column="canWrite" to="canWrite" eval="canWrite == '1' ? 'true' : 'false'"/>
    <bind column="canCreate" to="canCreate" eval="canCreate == '1' ? 'true' : 'false'"/>
    <bind column="canRemove" to="canRemove" eval="canRemove == '1' ? 'true' : 'false'"/>
    <bind column="canExport" to="canExport" eval="canExport == '1' ? 'true' : 'false'"/>
    <bind column="groupSet" to="groupSet" search="self.code = :groupSet"/>
  </input>

  <!-- App JBL visible dans l'App Management (Administration -> Apps) :
       modules = "axelor-jbl" lie automatiquement les menus du module à cette app
       (meta_menu.app renseigné à l'import), isInAppView = true l'affiche dans la liste. -->
  <input file="jbl_app.csv" separator=";" type="com.axelor.studio.db.App"
    search="self.code = :code">
    <bind column="code" to="code"/>
    <bind column="name" to="name"/>
    <bind column="description" to="description"/>
    <bind column="modules" to="modules"/>
    <bind column="typeSelect" to="typeSelect"/>
    <bind column="isCustom" to="isCustom" eval="isCustom == '1' ? 'true' : 'false'"/>
    <bind column="isInAppView" to="isInAppView" eval="isInAppView == '1' ? 'true' : 'false'"/>
    <bind column="active" to="active" eval="active == '1' ? 'true' : 'false'"/>
    <bind column="sequence" to="sequence"/>
    <bind column="appVersion" to="appVersion"/>
  </input>

</csv-inputs>
