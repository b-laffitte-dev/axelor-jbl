<?xml version="1.0" encoding="UTF-8"?>
<csv-inputs xmlns="http://axelor.com/xml/ns/data-import"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/data-import https://axelor.com/xml/ns/data-import/data-import_8.2.xsd">

  <!-- Séquence de numérotation des OR (MetaSequence, consommée via
       JpaSequence.nextValue("jbl.repair.order.seq") dans JblRepairOrderManagementRepository)
       => OR-00001, OR-00002... -->
  <input file="jbl_meta_sequence.csv" separator=";" type="com.axelor.meta.db.MetaSequence"
    search="self.name = :name">
    <bind column="name" to="name"/>
    <bind column="prefix" to="prefix"/>
    <bind column="padding" to="padding"/>
    <bind column="increment" to="increment"/>
    <bind column="initial" to="initial"/>
    <bind column="next" to="next"/>
  </input>

</csv-inputs>
