<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<views xmlns="http://axelor.com/xml/ns/views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/views https://axelor.com/xml/ns/views/views_8.2.xsd">

  <grid name="jbl-equipment-grid" title="Matériels" model="com.axelor.apps.jbl.db.JblEquipment">
    <field name="code"/>
    <field name="name"/>
    <field name="equipmentTypeSelect"/>
    <field name="brand"/>
    <field name="model"/>
    <field name="serialNumber"/>
    <field name="partner"/>
  </grid>

  <form name="jbl-equipment-form" title="Matériel" model="com.axelor.apps.jbl.db.JblEquipment" width="large">
    <panel title="Matériel de jardinage">
      <field name="code" colSpan="4"/>
      <field name="name" colSpan="8"/>
      <field name="equipmentTypeSelect" colSpan="6" widget="NavSelect"/>
      <field name="partner" colSpan="6" domain="self.isCustomer = true" canNew="true" canEdit="true"/>
      <field name="brand" colSpan="4"/>
      <field name="model" colSpan="4"/>
      <field name="serialNumber" colSpan="4"/>
      <field name="purchaseDate" colSpan="6"/>
      <field name="description" colSpan="12" widget="html"/>
    </panel>
  </form>

</views>
