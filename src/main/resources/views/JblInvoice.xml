<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<views xmlns="http://axelor.com/xml/ns/views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/views https://axelor.com/xml/ns/views/views_8.2.xsd">

  <grid name="jbl-invoice-grid" title="Factures" model="com.axelor.apps.jbl.db.JblInvoice">
    <field name="name"/>
    <field name="statusSelect" widget="NavSelect"/>
    <field name="partner"/>
    <field name="invoiceDate"/>
    <field name="dueDate"/>
    <field name="quotation"/>
    <field name="repairOrder"/>
    <field name="totalTTC"/>
  </grid>

  <form name="jbl-invoice-form" title="Facture" model="com.axelor.apps.jbl.db.JblInvoice" width="large"
        onNew="action-jbl-invoice-onnew" onSave="action-jbl-invoice-method-compute">
    <panel title="Facture">
      <field name="name" colSpan="3" readonly="true"/>
      <field name="statusSelect" colSpan="3" widget="NavSelect" readonly="true"/>
      <field name="invoiceDate" colSpan="3"/>
      <field name="dueDate" colSpan="3"/>
      <field name="partner" colSpan="6" domain="self.isCustomer = true" canNew="true" canEdit="true"/>
      <field name="company" colSpan="6" readonly="true"/>
      <field name="quotation" colSpan="6"/>
      <field name="repairOrder" colSpan="6"/>
      <field name="paymentDate" colSpan="6" readonly="true"/>
    </panel>
    <panel title="Lignes de facture">
      <panel-related name="lineListPanel" field="lineList" colSpan="12"
                     grid-view="jbl-invoice-line-grid" form-view="jbl-invoice-line-form"
                     canNew="true" canEdit="true" canRemove="true"/>
    </panel>
    <panel title="Totaux">
      <field name="totalHT" colSpan="3" readonly="true"/>
      <field name="vatRate" colSpan="3"/>
      <field name="totalVAT" colSpan="3" readonly="true"/>
      <field name="totalTTC" colSpan="3" readonly="true"/>
    </panel>
    <panel sidebar="true">
      <button name="btnCompute" title="Recalculer les totaux" colSpan="12"
              onClick="save,action-jbl-invoice-method-compute"/>
      <button name="btnValidate" title="Valider la facture" colSpan="12"
              onClick="save,action-jbl-invoice-method-validate" showIf="statusSelect == 0"/>
      <button name="btnPaid" title="Paiement reçu" colSpan="12"
              onClick="save,action-jbl-invoice-method-pay" showIf="statusSelect == 1"/>
      <button name="btnCancel" title="Annuler la facture" colSpan="12"
              onClick="save,action-jbl-invoice-method-cancel" showIf="statusSelect &lt; 2"/>
    </panel>
  </form>

  <grid name="jbl-invoice-line-grid" title="Lignes de facture" model="com.axelor.apps.jbl.db.JblInvoiceLine">
    <field name="product"/>
    <field name="description"/>
    <field name="quantity"/>
    <field name="unitPriceHT"/>
    <field name="totalHT"/>
  </grid>

  <form name="jbl-invoice-line-form" title="Ligne de facture" model="com.axelor.apps.jbl.db.JblInvoiceLine">
    <panel>
      <field name="product" colSpan="6" domain="self.productTypeSelect = 'storable'"/>
      <field name="description" colSpan="12"/>
      <field name="quantity" colSpan="4"/>
      <field name="unitPriceHT" colSpan="4"/>
      <field name="totalHT" colSpan="4" readonly="true"/>
    </panel>
  </form>

</views>
