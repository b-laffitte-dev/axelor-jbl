<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.2.xsd">

  <!-- Nomenclature : jbl.<entité>.<champ>.select -->
  <!-- V1 : seuls les statuts/types propres à l'atelier restent en custom ; devis, factures,
       mouvements de stock et équipements utilisent les sélections natives des modules AOS. -->

  <selection name="jbl.repair.order.status.select">
    <option value="0">Selection.JblRepairOrder.Status.0</option>
    <option value="1">Selection.JblRepairOrder.Status.1</option>
    <option value="2">Selection.JblRepairOrder.Status.2</option>
    <option value="3">Selection.JblRepairOrder.Status.3</option>
    <option value="4">Selection.JblRepairOrder.Status.4</option>
  </selection>

  <selection name="jbl.repair.line.type.select">
    <option value="0">Selection.JblRepairLine.Type.0</option>
    <option value="1">Selection.JblRepairLine.Type.1</option>
    <option value="2">Selection.JblRepairLine.Type.2</option>
  </selection>

</object-views>
