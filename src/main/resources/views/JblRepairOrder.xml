<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.2.xsd">

  <grid name="jbl-repair-order-grid" title="View.JblRepairOrder.Grid.Title" model="com.axelor.apps.jbl.db.JblRepairOrder"
        orderBy="-receptionDate">
    <field name="name"/>
    <field name="statusSelect" widget="NavSelect"/>
    <field name="partner"/>
    <field name="equipment"/>
    <field name="receptionDate"/>
    <field name="plannedDate"/>
    <field name="technician"/>
    <field name="quotation"/>
    <field name="invoice"/>
    <field name="totalHT"/>
  </grid>

  <kanban name="jbl-repair-order-kanban" title="View.JblRepairOrder.Kanban.Title" model="com.axelor.apps.jbl.db.JblRepairOrder"
          columnBy="statusSelect" sequenceBy="sequence">
    <field name="name"/>
    <field name="partner"/>
    <field name="equipment"/>
    <field name="plannedDate"/>
    <field name="technician"/>
    <field name="totalHT"/>
    <template><![CDATA[
      <div class="kanban-card">
        <strong>{{name}}</strong><br/>
        {{partner.name}}<br/>
        {{#equipment}}{{equipment.name}}<br/>{{/equipment}}
        {{#technician}}Tech : {{technician.name}}<br/>{{/technician}}
        Prévu : {{plannedDate}}<br/>
        <b>{{totalHT}} € HT</b>
      </div>
    ]]></template>
  </kanban>

  <form name="jbl-repair-order-form" title="View.JblRepairOrder.Form.Title" model="com.axelor.apps.jbl.db.JblRepairOrder" width="large"
        onNew="action-jbl-repair-order-onnew" onSave="action-jbl-repair-order-method-compute">
    <panel title="Panel.JblRepairOrder.Main">
      <field name="name" colSpan="3" readonly="true"/>
      <field name="statusSelect" colSpan="3" widget="NavSelect" readonly="true"/>
      <field name="receptionDate" colSpan="3"/>
      <field name="plannedDate" colSpan="3"/>
      <field name="partner" colSpan="6" domain="self.isCustomer = true" canNew="true" canEdit="true"/>
      <field name="company" colSpan="6" readonly="true"/>
      <field name="equipment" colSpan="6" canNew="true" canEdit="true" form-view="jbl-equipment-form" grid-view="jbl-equipment-grid"/>
      <field name="materialDescription" colSpan="6"/>
      <field name="technician" colSpan="6"/>
      <field name="diagnosis" colSpan="12" widget="html"/>
      <field name="workDone" colSpan="12" widget="html"/>
      <field name="internalNotes" colSpan="12" widget="html"/>
    </panel>
    <panel title="Panel.JblRepairOrder.Lines">
      <panel-related name="repairLineListPanel" field="repairLineList" colSpan="12"
                     grid-view="jbl-repair-line-grid" form-view="jbl-repair-line-form"
                     canNew="true" canEdit="true" canRemove="true"/>
    </panel>
    <panel title="Panel.JblRepairOrder.Total">
      <field name="totalHT" colSpan="3" readonly="true"/>
    </panel>
    <panel title="Panel.JblRepairOrder.Documents">
      <field name="quotation" colSpan="4" readonly="true"/>
      <field name="invoice" colSpan="4" readonly="true"/>
      <field name="stockMove" colSpan="4" readonly="true"/>
    </panel>
    <panel sidebar="true">
      <button name="btnStart" title="Button.JblRepairOrder.Start" colSpan="12"
              onClick="save,action-jbl-repair-order-method-start" showIf="statusSelect == 0"/>
      <button name="btnComplete" title="Button.JblRepairOrder.Complete" colSpan="12"
              onClick="save,action-jbl-repair-order-method-complete" showIf="statusSelect == 1"/>
      <button name="btnToQuotation" title="Button.JblRepairOrder.ToQuotation" colSpan="12"
              onClick="save,action-jbl-repair-order-method-to-quotation" showIf="quotation == null"/>
      <button name="btnToInvoice" title="Button.JblRepairOrder.ToInvoice" colSpan="12"
              onClick="save,action-jbl-repair-order-method-to-invoice" showIf="statusSelect == 2 &amp;&amp; invoice == null"/>
      <button name="btnCancel" title="Button.JblRepairOrder.Cancel" colSpan="12"
              onClick="save,action-jbl-repair-order-method-cancel" showIf="statusSelect &lt; 2"/>
    </panel>
  </form>

  <grid name="jbl-repair-line-grid" title="View.JblRepairLine.Grid.Title" model="com.axelor.apps.jbl.db.JblRepairLine">
    <field name="lineTypeSelect" widget="NavSelect"/>
    <field name="product"/>
    <field name="description"/>
    <field name="quantity"/>
    <field name="unitPriceHT"/>
    <field name="totalHT"/>
  </grid>

  <form name="jbl-repair-line-form" title="View.JblRepairLine.Form.Title" model="com.axelor.apps.jbl.db.JblRepairLine"
        onSave="action-jbl-repair-order-method-compute">
    <panel>
      <field name="lineTypeSelect" colSpan="6" widget="NavSelect"/>
      <field name="product" colSpan="6" showIf="lineTypeSelect == 0" domain="self.productTypeSelect = 'storable'"/>
      <field name="description" colSpan="12"/>
      <field name="quantity" colSpan="4"/>
      <field name="unitPriceHT" colSpan="4"/>
      <field name="totalHT" colSpan="4" readonly="true"/>
    </panel>
  </form>

</object-views>
