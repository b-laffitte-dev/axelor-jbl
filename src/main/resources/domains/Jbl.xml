<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.2.xsd">

  <!-- AOP 8.2 : <module> est un marqueur, les <entity> sont des éléments frères au niveau racine -->
  <module name="Jbl" package="com.axelor.apps.jbl.db"/>

  <!-- ================================================================== -->
  <!-- V1 : le module ne garde que le cœur métier atelier.                 -->
  <!-- Devis = sale.SaleOrder, Facture = account.Invoice,                 -->
  <!-- Stock = stock.StockMove/StockLocation, Matériel = intervention.Equipment, -->
  <!-- numérotation = base.Sequence (jbl.repair.order.seq, voir data-init) -->
  <!-- ================================================================== -->

  <!-- Fiche d'ordre de réparation (OR) -->
  <entity name="JblRepairOrder" cacheable="true">
    <![CDATA[Fiche d'ordre de réparation d'un matériel de jardinage]]>
    <string name="name" title="N° d'OR" unique="true" readonly="true" copy="false"
            sequence="jbl.repair.order.seq"/>
    <integer name="statusSelect" title="Statut" selection="jbl.repair.order.status.select" default="0"/>
    <integer name="sequence" title="Séquence" default="0" hidden="true"/>
    <many-to-one name="partner" ref="com.axelor.apps.base.db.Partner" title="Client" required="true"/>
    <many-to-one name="equipment" ref="com.axelor.apps.intervention.db.Equipment" title="Matériel"/>
    <string name="materialDescription" title="Matériel (si non enregistré)" large="true"/>
    <date name="receptionDate" title="Date de réception" required="true"/>
    <date name="plannedDate" title="Date prévue de restitution"/>
    <many-to-one name="technician" ref="com.axelor.auth.db.User" title="Technicien"/>
    <many-to-one name="company" ref="com.axelor.apps.base.db.Company" title="Société"/>
    <string name="diagnosis" title="Diagnostic / panne constatée" large="true"/>
    <string name="workDone" title="Travaux réalisés" large="true"/>
    <string name="internalNotes" title="Notes internes" large="true"/>
    <one-to-many name="repairLineList" ref="com.axelor.apps.jbl.db.JblRepairLine" mappedBy="repairOrder" title="Lignes de réparation"/>
    <decimal name="totalHT" title="Total HT (indicatif)" precision="19" scale="2" readonly="true"/>
    <many-to-one name="quotation" ref="com.axelor.apps.sale.db.SaleOrder" title="Devis (SaleOrder)"/>
    <many-to-one name="invoice" ref="com.axelor.apps.account.db.Invoice" title="Facture (Invoice)"/>
    <many-to-one name="stockMove" ref="com.axelor.apps.stock.db.StockMove" title="Mouvement de stock (conso. pièces)"/>
  </entity>

  <!-- Ligne d'OR : pièce détachée, main d'oeuvre ou forfait -->
  <entity name="JblRepairLine" cacheable="true">
    <![CDATA[Ligne d'un ordre de réparation : pièce détachée, main d'œuvre ou forfait]]>
    <many-to-one name="repairOrder" ref="com.axelor.apps.jbl.db.JblRepairOrder" title="Ordre de réparation"/>
    <integer name="lineTypeSelect" title="Type de ligne" selection="jbl.repair.line.type.select" required="true" default="0"/>
    <many-to-one name="product" ref="com.axelor.apps.base.db.Product" title="Pièce détachée"/>
    <string name="description" title="Désignation" required="true"/>
    <decimal name="quantity" title="Qté (ou heures pour la main d'œuvre)" precision="19" scale="3" default="1"/>
    <decimal name="unitPriceHT" title="PU HT" precision="19" scale="2"/>
    <decimal name="totalHT" title="Total HT" precision="19" scale="2" readonly="true"/>
  </entity>

</domain-models>
